<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Holy Legend - 冒險中</title>
    <link rel="icon" type="image/png" href="/holylegend.png">
    <link rel="stylesheet" href="/holylegend/styles/game.css">
    <link rel="stylesheet" href="/holylegend/styles/tower.css"> <!-- 新增戰鬥專用樣式 -->
    <link rel="stylesheet" href="/holylegend/styles/team.css"> <!-- 新增戰鬥專用樣式 -->
    <link rel="stylesheet" href="/holylegend/styles/skill.css">
    <link rel="stylesheet" href="/holylegend/styles/class.css">
    <link rel="stylesheet" href="/holylegend/styles/setting.css">
    <link rel="stylesheet" href="/holylegend/styles/event.css">
    <link rel="stylesheet" href="/holylegend/styles/reward.css">
    <link rel="stylesheet" href="/holylegend/styles/shop.css">
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
</head>
<body>
    <audio id="bg-music-source" src="/holylegend/audio/game_lobby.ogg" loop></audio>
    <audio id="bg-sound-source" src=""></audio>

    <div class="mobile-container">
        <!-- ========================================== -->
        <!--  區塊 A: 遊戲大廳 (Lobby)                  -->
        <!-- ========================================== -->
        <div id="lobby-layer">
            <!-- 這是你原本的 Header -->
            <header class="player-status-panel">
                <div class="avatar-container">
                    <div class="avatar-frame">
                        <!-- EJS 變數注入範例 -->
                        <img id="lobbyAvatar" src="<%= user.avatar %>" class="pixel-art">
                    </div>
                    <div class="level-badge"><span id="lobbyLevel"><%= user.level %></span></div>
                </div>
                <div class="stats-container">
                    <div class="player-name" id="lobbyName"><%= user.nickname %></div>
                    
                    <!-- HP 血條 -->
                    <div class="stat-bar-row">
                        <span class="label" style="color: #e74c3c;">HP</span>
                        <div class="bar-bg">
                            <!-- EJS 計算寬度: (當前/最大) * 100 -->
                            <div class="bar-fill hp-fill" id="lobbyHpBar" style="width: <%= (user.hp / user.maxHp) * 100 %>%;"></div>
                            <!-- 數值疊加在中間 -->
                            <span class="bar-text" id="lobbyHpText"><%= user.hp %>/<%= user.maxHp %></span>
                        </div>
                    </div>

                    <!-- MP 魔力條 -->
                    <div class="stat-bar-row">
                        <span class="label" style="color: #3498db;">MP</span>
                        <div class="bar-bg">
                            <div class="bar-fill mp-fill" id="lobbyMpBar" style="width: <%= (user.mp / user.maxMp) * 100 %>%;"></div>
                            <span class="bar-text" id="lobbyMpText"><%= user.mp %>/<%= user.maxMp %></span>
                        </div>
                    </div>

                    <!-- 經驗條 -->
                    <div class="stat-bar-row">
                        <span class="label" style="color: #3cff27;">EXP</span>
                        <div class="bar-bg">
                            <!-- EJS 計算寬度: (當前/最大) * 100 -->
                            <div class="bar-fill exp-fill" id="lobbyEXPBar" style="width: <%= (user.exp / user.needEXP) * 100 %>%;"></div>
                            <!-- 數值疊加在中間 -->
                            <span class="bar-text" id="lobbyEXPText"><%= user.exp %>/<%= user.needEXP %></span>
                        </div>
                    </div>
                </div>
            </header>

            <main class="main-actions">
                <!-- 點擊進入爬塔 -->
                <div class="action-card tower-card" id="btn-enter-tower">
                    <div class="card-content">
                        <h2>爬塔</h2>
                        <p>MAIN TOWER</p>
                        <div class="icon pixel-art">🏰</div>
                    </div>
                </div>
                <div class="action-card tavern-card" id="btn-open-team">
                    <div class="card-content">
                        <h2>酒館</h2>
                        <p>TAVERN</p>
                        <div class="icon pixel-art">🍺</div>
                    </div>
                </div>
                <!-- 其他按鈕... -->
                <div class="action-card guild-card" onclick="alert('公會招募中')">
                    <div class="card-content">
                        <h2>公會</h2><div class="icon pixel-art">🛡️</div>
                    </div>
                </div>
            </main>

            <!-- 底部選單 -->
            <footer class="bottom-menu">
                <button class="menu-btn" id="btn-open-job">
                    <span class="icon">⚔️</span>職業
                </button>

                <!-- ★ 修改這裡：加入 id="btn-open-skill" -->
                <button class="menu-btn" id="btn-open-skill">
                    <span class="icon">⚒️</span>符文
                </button>

                <!-- 設定按鈕 -->
                <button class="menu-btn" id="btn-open-settings">
                    <span class="icon">⚙️</span>選單
                </button>
            </footer>
        </div>

        <!-- ========================================== -->
        <!--  區塊 B: 爬塔戰鬥 (Tower Interface)         -->
        <!--  預設隱藏 (hidden)                         -->
        <!-- ========================================== -->
        <div id="tower-layer" class="hidden">
            <!-- ========================================== -->
            <!--  區塊 F: 多人準備確認 (Ready Check)         -->
            <!--  預設隱藏                                   -->
            <!-- ========================================== -->
            <div id="ready-check-layer" class="hidden">
                <div class="ready-title">隊伍準備確認</div>
                <div class="ready-subtitle">等待全員接受...</div>

                <div id="ready-slots-container">
                </div>

                <div class="ready-actions">
                    <button id="btn-ready-accept" class="btn-pixel-medium btn-accept">準備</button>
                </div>
            </div>
            
            <!-- 1. 頂部資訊列 (Top Info) -->
            <div class="tower-header">
                <div class="tower-info">
                    <div class="info-item">FLOOR: <span id="tower-floor">1</span></div>
                    <div class="info-item text-gold">GOLD: <span id="tower-gold">0</span></div>
                </div>
            </div>

            <!-- 2. 中央舞台 (Main Stage) -->
            <div class="tower-stage">
                <!-- 怪物或寶箱顯示區 -->
                <div class="enemy-container">
                    <div class="damage-text" id="damage-popup"></div> <!-- 傷害跳字 -->
                    <img id="enemy-img" src="/holylegend/images/enemies/slime.png" class="pixel-art enemy-anim">
                    <div class="enemy-hp-bar">
                        <div class="enemy-hp-fill" id="enemy-hp-fill" style="width: 100%;"></div>
                    </div>
                </div>
            </div>

            <!-- 【新增】隊友狀態列 (Teammates HUD) -->
            <div id="teammates-container"></div>

            <!-- 【新增】狀態列 (Status HUD) -->
            <div id="status-container"></div>

            <!-- 3. 玩家狀態 (Player Status) -->
            <div class="tower-player-status">
                <div class="status-row">
                    <span class="label">HP</span>
                    <div class="bar-frame">
                        <div class="bar-fill hp-fill" id="battle-hp-bar" style="width: 100%;"></div>
                        <span class="bar-num" id="battle-hp-text">100/100</span>
                    </div>
                </div>
                <div class="status-row">
                    <span class="label">MP</span>
                    <div class="bar-frame">
                        <div class="bar-fill mp-fill" id="battle-mp-bar" style="width: 100%;"></div>
                        <span class="bar-num" id="battle-mp-text">50/50</span>
                    </div>
                </div>
            </div>

            <!-- 4. 底部操作區 (Control Panel) -->
            <div class="tower-controls">
                <!-- 攻擊按鈕 -->
                <button class="control-btn btn-attack" id="btn-attack">
                    <div class="icon">🗡️</div>
                    <span>攻擊</span>
                </button>

                <!-- 道具按鈕 -->
                <button class="control-btn btn-item" id="btn-item">
                    <div class="icon">🎒</div>
                    <span>道具</span>
                </button>

                <!-- 技能/查看按鈕 -->
                <button class="control-btn btn-skill" id="btn-skill">
                    <div class="icon">📖</div>
                    <span>技能</span>
                </button>
            </div>

            <!-- 獎勵選擇區塊    -->
            <div id="reward-layer" class="hidden">
                <div class="reward-title">LEVEL CLEARED!</div>
                <div class="reward-subtitle">Choose a buff</div>
                
                <div id="reward-cards-container">
                </div>
            </div>


            <!-- ========================================== -->
            <!--  區塊 I: 隨機事件 (Event Layer)            -->
            <!-- ========================================== -->
            <div id="event-layer" class="hidden">
            </div>


            <!-- ========================================== -->
            <!--  區塊 J: 商店介面 (Shop Layer)             -->
            <!-- ========================================== -->
            <div id="shop-layer" class="hidden">
                <!-- 半透明背景遮罩 -->
                <div class="shop-overlay"></div>

                <div class="shop-card-container">
                    <!-- ★ 新增：右上角關閉按鈕 -->
                    <button id="btn-close-shop" class="btn-pixel-close">X</button>

                    <!-- 1. 商店頂部 -->
                    <div class="shop-header">
                        <div class="shop-title-group">
                            <span class="shop-npc-icon">👜</span>
                            <span class="shop-title">旅行商人</span>
                        </div>
                        <div class="shop-gold-display">
                            <span class="gold-icon">💰</span>
                            <span id="shop-gold-val" class="gold-val">0</span>
                        </div>
                    </div>

                    <!-- 2. 商品列表 -->
                    <div class="shop-body">
                        <div id="shop-items-grid" class="shop-grid">
                            <!-- JS 動態生成 -->
                        </div>
                    </div>

                    <!-- 3. 底部 (只保留訊息提示) -->
                    <div class="shop-footer">
                        <div class="shop-message" id="shop-message">歡迎光臨，冒險者...</div>
                    </div>
                </div>
            </div>

        </div>



        <!-- ========================================== -->
        <!--  區塊 C: 職業切換 (Job Selection)           -->
        <!-- ========================================== -->
        <div id="job-layer" class="hidden">
            
            <!-- 標題列 -->
            <div class="layer-header">
                <h2 class="pixel-title">職業一覽</h2>
                <button id="btn-close-job" class="btn-pixel-small">X</button>
            </div>

            <!-- 職業列表容器 (內容由 JS 動態生成) -->
            <div id="job-list-container" class="scrollable-content">
                <div class="loading-text">載入中...</div>
            </div>

        </div>



        <!-- ========================================== -->
        <!--  區塊 E: 多人組隊 (Team Interface)          -->
        <!-- ========================================== -->
        <div id="team-layer" class="hidden">
            
            <!-- 標題與關閉鈕 -->
            <div class="layer-header">
                <h2 class="pixel-title">冒險者酒館</h2>
                <button id="btn-close-team" class="btn-pixel-small">X</button>
            </div>

            <!-- 操作區 (創建 / 加入) -->
            <div class="team-actions">
                <button id="btn-create-team" class="btn-pixel-large">創建隊伍</button>
                <button id="btn-join-team" class="btn-pixel-large">加入隊伍</button>
            </div>

            <!-- 主內容區 (包含隊伍列表 & 聊天室) -->
            <div class="team-container">
                
                <!-- 上半部：隊員列表 -->
                <div class="section-members">
                    <div class="team-status-text">目前隊伍 (1/4)</div>
                    <div id="team-members-list">
                    </div>
                </div>

                <!-- 下半部：聊天室 (新增) -->
                <div class="section-chat">
                    <div class="chat-header">隊伍頻道</div>
                    
                    <!-- 訊息顯示區 -->
                    <div id="chat-messages" class="chat-box">
                        <div class="chat-line system">
                        </div>
                        <div class="chat-line">
                        </div>
                    </div>

                    <!-- 輸入區 -->
                    <div class="chat-input-area">
                        <input type="text" id="chat-input" placeholder="輸入訊息..." maxlength="50">
                        <button id="btn-chat-send" class="btn-pixel-small">送出</button>
                    </div>
                </div>

            </div>

            <!-- 底部準備按鈕 -->
            <div class="team-footer">
                <button id="btn-invite-team" class="btn-pixel-wide" style="display:none; background-color: #3498db; margin-bottom: 10px;">邀請</button>
                <button id="btn-leave-team" class="btn-pixel-wide btn-danger" style="display:none;">離開隊伍</button>
            </div>

        </div>



        <!-- ========================================== -->
        <!--  區塊 G: 系統選單 (Settings Layer)          -->
        <!-- ========================================== -->
        <div id="settings-layer" class="hidden">
            
            <div class="layer-header">
                <h2 class="pixel-title">系統設定</h2>
                <button id="btn-close-settings" class="btn-pixel-small">X</button>
            </div>

            <div class="settings-container">
                
                <!-- 1. 頭像設定 -->
                <div class="setting-section">
                    <div class="section-title">角色資料</div>
                    
                    <div class="avatar-upload-area">
                        <div class="preview-box">
                            <img id="settings-avatar-preview" src="<%= user.avatar %>" class="pixel-art">
                        </div>
                        <div class="upload-controls">
                            <label for="file-upload" class="btn-pixel-medium">
                                📤 上傳頭像
                            </label>
                            <input id="file-upload" type="file" accept="image/*" style="display: none;"/>
                            <div class="tip-text">建議尺寸: 64x64</div>
                        </div>
                    </div>

                    <div class="name-edit-area">
                        <label>冒險者暱稱</label>
                        <div class="input-group">
                            <input type="text" id="settings-nickname-input" placeholder="輸入新名字" maxlength="10">
                            <button id="btn-save-name" class="btn-pixel-small">修改</button>
                        </div>
                    </div>
                </div>

                <hr class="pixel-divider">

                <!-- 2. 音效設定 -->
                <div class="setting-section">
                    <div class="section-title">音效設定</div>
                    
                    <div class="toggle-row">
                        <span>背景音樂 (BGM)</span>
                        <label class="pixel-switch">
                            <input type="checkbox" id="toggle-bgm" checked>
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="toggle-row">
                        <span>遊戲音效 (SFX)</span>
                        <label class="pixel-switch">
                            <input type="checkbox" id="toggle-sfx" checked>
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>

                <div class="setting-section">
                    <div class="section-title" id="keybind-section">快捷鍵設定</div>
                        
                    <div class="shortcut-row horizontal">
                        <div class="shortcut-row">
                            <label for="key-attack">攻擊</label>
                            <input type="text" id="key-attack" class="shortcut-input" maxlength="1" value="Z" data-action="ATTACK">
                        </div>
                        <div class="shortcut-row">
                            <label for="key-item">道具</label>
                            <input type="text" id="key-item" class="shortcut-input" maxlength="1" value="X" data-action="ITEM">
                        </div>
                        <div class="shortcut-row">
                                <label for="key-skill">技能</label>
                                <input type="text" id="key-skill" class="shortcut-input" maxlength="1" value="C" data-action="SKILL">
                            </div>
                            <div class="shortcut-row">
                                <label for="key-confirm">確認</label>
                                <input type="text" id="key-confirm" class="shortcut-input" maxlength="1" value="Q" data-action="CONFIRM">
                            </div>
                            <div class="shortcut-row">
                                <label for="key-cancel">取消</label>
                                <input type="text" id="key-cancel" class="shortcut-input" maxlength="1" value="E" data-action="CANCEL">
                            </div>
                        </div>
                        
                        <br>
                        <div class="shortcut-row horizontal">
                            <div class="shortcut-item">
                                <label for="key-reward-1">1</label>
                                <input type="text" id="key-reward-1" class="shortcut-input" maxlength="1" value="1" data-action="QUICK_1">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-2">2</label>
                                <input type="text" id="key-reward-2" class="shortcut-input" maxlength="1" value="2" data-action="QUICK_2">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-3">3</label>
                                <input type="text" id="key-reward-3" class="shortcut-input" maxlength="1" value="3" data-action="QUICK_3">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-4">4</label>
                                <input type="text" id="key-reward-4" class="shortcut-input" maxlength="1" value="4" data-action="QUICK_4">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-5">5</label>
                                <input type="text" id="key-reward-5" class="shortcut-input" maxlength="1" value="5" data-action="QUICK_5">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-6">6</label>
                                <input type="text" id="key-reward-6" class="shortcut-input" maxlength="1" value="6" data-action="QUICK_6">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-7">7</label>
                                <input type="text" id="key-reward-4" class="shortcut-input" maxlength="1" value="7" data-action="QUICK_7">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-8">8</label>
                                <input type="text" id="key-reward-5" class="shortcut-input" maxlength="1" value="8" data-action="QUICK_8">
                            </div>
                            <div class="shortcut-item">
                                <label for="key-reward-9">9</label>
                                <input type="text" id="key-reward-6" class="shortcut-input" maxlength="1" value="9" data-action="QUICK_9">
                            </div>
                        </div>

                    <br>
                    <button id="btn-save-shortcuts" class="btn-pixel-small" style="margin-top: 5px;">儲存快捷鍵</button>
                    <button id="btn-reset-shortcuts" class="btn-pixel-small" style="margin-top: 5px;">還原</button>
                </div>

                <!-- 登出 -->
                <div class="setting-section">
                    <button id="btn-logout" class="btn-pixel-small">登出</button>
                </div>

                <div class="version-text">Ver 1.0.0 Alpha</div>
            </div>
        </div>


        <!-- ========================================== -->
        <!--  區塊 K: 技能工坊 (Skill Forge Layer)      -->
        <!-- ========================================== -->
        <div id="skill-layer" class="hidden">
            <div class="skill-header">
                <div class="forge-title">⚒️ 技能工坊</div>
                <div class="header-controls">
                    <button id="btn-refresh-skill" class="btn-pixel-icon btn-refresh">↻</button>
                    <button id="btn-close-skill" class="btn-pixel-icon btn-close">X</button>
                </div>
            </div>

            <div class="skill-content-wrapper">
                
                <div id="view-equip" class="view-section">
                    <div class="top-section-group">
                        
                        <div class="forge-stage">
                            <div class="forge-pedestal">
                                <div class="soul-fire">🔥</div>
                                <div class="skill-slot slot-1" data-slot="0"></div>
                                <div class="skill-slot slot-2" data-slot="1"></div>
                                <div class="skill-slot slot-3" data-slot="2"></div>
                                <div class="skill-slot slot-4" data-slot="3"></div>
                                <div class="skill-slot slot-5" data-slot="4"></div>
                                <div class="skill-slot slot-6" data-slot="5"></div>
                                <div class="skill-slot slot-7" data-slot="6"></div>
                                <div class="skill-slot slot-8" data-slot="7"></div>
                            </div>
                            <div class="forge-info">已裝備: <span id="equipped-count">0</span>/8</div>
                        </div>

                        <div class="stats-area" id="stats-area">
                            <div class="stats-grid">
                                <div class="stat-item"><span class="s-icon">💓</span><span class="s-label">生命</span><span id="val-hp-bonus" class="s-val">+0</span></div>
                                <div class="stat-item"><span class="s-icon">💧</span><span class="s-label">魔力</span><span id="val-mp-bonus" class="s-val">+0</span></div>
                                <div class="stat-item"><span class="s-icon">⚔️</span><span class="s-label">攻擊</span><span id="val-atk" class="s-val">+0%</span></div>
                                <div class="stat-item"><span class="s-icon">🪄</span><span class="s-label">技能</span><span id="val-skill-dmg" class="s-val">+0%</span></div>
                                <div class="stat-item"><span class="s-icon">🛡️</span><span class="s-label">減傷</span><span id="val-dmg-red" class="s-val">0%</span></div>
                                <div class="stat-item"><span class="s-icon">💥</span><span class="s-label">爆擊</span><span id="val-crit" class="s-val">0%</span></div>
                                <div class="stat-item"><span class="s-icon">🦶</span><span class="s-label">閃避</span><span id="val-dodge" class="s-val">0%</span></div>
                                <div class="stat-item"><span class="s-icon">🌱</span><span class="s-label">再生</span><span id="val-regen" class="s-val">0/s</span></div>
                                <div class="stat-item"><span class="s-icon">💧</span><span class="s-label">回流</span><span id="val-mana-reflow" class="s-val">0/s</span></div>
                                <div class="stat-item"><span class="s-icon">✨</span><span class="s-label">經驗</span><span id="val-exp" class="s-val">+0%</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="view-synthesis" class="view-section hidden">
                    <div class="synthesis-container" id="synthesis-area">
                        <div class="inventory-label">--- 符文熔煉 ---</div>
                        <div class="syn-slots-row">
                            <div class="syn-slot" data-index="0"></div>
                            <div class="syn-plus">+</div>
                            <div class="syn-slot" data-index="1"></div>
                            <div class="syn-plus">+</div>
                            <div class="syn-slot" data-index="2"></div>
                        </div>
                        <div class="anvil-section">
                            <img src="/holylegend/images/other/anvil.png" class="anvil-img" onerror="this.src='/holylegend/images/items/default.png'">
                            <button id="btn-do-synthesis" class="btn-do-synthesis" disabled>⚡ 開始熔煉</button>
                        </div>
                    </div>
                </div>

                <div id="view-handbook" class="view-handbook hidden">
                    <div id="handbook-area" class="handbook-container">
                        <div class="inventory-label">--- 符文圖鑑 (收集率: <span id="collection-rate">0%</span>) ---</div>
                        <div class="hb-filter-row">
                            <button class="btn-pixel-small" onclick="window.filterHandbook('ALL')">全部</button>
                            <button class="btn-pixel-small" onclick="window.filterHandbook('CLASS')">職業</button>
                            <button class="btn-pixel-small" onclick="window.filterHandbook('GENERAL')">通用</button>
                        </div>
                        <div id="handbook-grid" class="inventory-grid">
                            </div>
                    </div>
                </div>

                <div id="view-inventory" class="inventory-area">
                    <div class="inventory-label">--- 符文倉庫 ---</div>
                    <div id="skill-inventory-grid" class="inventory-grid">
                        <div class="empty-msg">沒有可用的技能石</div>
                    </div>
                </div>

            </div>

            <div class="skill-footer">
                <button id="btn-skill-book" class="btn-forge" style="background-color: #2f5cfc; border-color: #0016bb;">📘<br>圖鑑</button>
                <button id="btn-open-bag" class="btn-forge hidden">🎒<br>背包</button>
                <button id="btn-unequip-all" class="btn-forge" style="background-color: #c0392b; border-color: #922b21;">🔻<br>全卸</button>
                <button id="btn-synthesis" class="btn-forge btn-action">🔥<br>冶煉</button>
            </div>
        </div>


        

    </div>

    <!-- 引入邏輯腳本 -->
    <script>
        window.JOIN_ROOM_ID = "<%= joinRoomId %>";
    </script>
