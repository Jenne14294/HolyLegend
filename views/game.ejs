    <script src="/holylegend/scripts/skill_system.js"></script>
    <script src="/holylegend/scripts/team_system.js"></script>
    <script src="/holylegend/scripts/setting_system.js"></script>
    <script src="/holylegend/scripts/game_audio.js"></script>
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>   <!-- 新增這行 -->
</body>
